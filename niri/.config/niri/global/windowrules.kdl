window-rule {
    match app-id="^org\\.wezfurlong\\.wezterm$"
}

window-rule {
    match app-id="^org\\.gnome\\."
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
}

window-rule {
    match app-id="^nm-connection-editor$"
    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id="^xdg-desktop-portal$"
    open-floating true
}

window-rule {
    match app-id="^steam$" title="^notificationtoasts_\\d+_desktop$"
    open-focused false
}

window-rule {
    match app-id="kitty"
    draw-border-with-background false
}

window-rule {
    match app-id="zoom" title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id="^DesktopEditors$"
    default-column-width { fixed 960; }
    default-window-height { fixed 720; }
}

window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}
