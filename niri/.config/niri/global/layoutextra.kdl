layout {
    background-color "#000000"
    always-center-single-column

    border {
        on
        width 2
    }

    tab-indicator {
        place-within-column
        position "top"
        gap 2
    }
    focus-ring
    shadow {
        on
    }
}

window-rule {
    draw-border-with-background false
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match is-active=false
    opacity 0.9 // Adjust the opacity value (0.0 to 1.0) as desired
}
