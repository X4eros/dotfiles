layout {

    focus-ring {
        active-color   "#d1bcff"
        inactive-color "#15121a"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d1bcff"
        inactive-color "#15121a"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#d1bcff"
        inactive-color "#582bad"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d1bcff80"
    }
}

recent-windows {
    highlight {
        active-color "#d1bcff"
        urgent-color "#ffb4ab"
    }
}
